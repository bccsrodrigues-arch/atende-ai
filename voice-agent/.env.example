/**
 * ==============================================================
 * ARQUIVO DE CONFIGURAÇÃO (.env)
 * ==============================================================
 * Configure as variáveis de ambiente para o sistema funcionar
 * 
 * IMPORTANTE: Nunca faça commit deste arquivo em Git!
 * Mantenha as senhas e chaves seguras
 */

# ========== SERVIDOR ==========
NODE_ENV=development
PORT=3000

# ========== OPENAI API ==========
# Obter chave em: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-SUA_CHAVE_OPENAI_AQUI

# ========== TWILIO (CHAMADAS TELEFÔNICAS) ==========
# Obter em: https://www.twilio.com/console
TWILIO_ACCOUNT_SID=SEU_ACCOUNT_SID_AQUI
TWILIO_AUTH_TOKEN=SEU_AUTH_TOKEN_AQUI
TWILIO_PHONE_NUMBER=+1SEU_NUMERO_AQUI

# ========== BANCO DE DADOS ==========
# SQLite não precisa de configuração (arquivo local)
# Para usar outro banco (PostgreSQL, MySQL), ajuste conforme necessário
DB_PATH=./database/database.db

# ========== CONFIGURAÇÕES DE VOZ ==========
# Idioma padrão para TTS (Text-To-Speech)
VOICE_LANGUAGE=pt-BR
# Gênero da voz: male ou female
VOICE_GENDER=female
# Velocidade: slow, medium, fast
VOICE_SPEED=medium

# ========== LIMITES E TIMEOUTS ==========
# Tempo máximo de espera por resposta da IA (segundos)
IA_TIMEOUT=30
# Duração máxima de uma chamada (segundos)
MAX_CALL_DURATION=600
# Tempo de espera antes de transferir para atendente (segundos)
TRANSFER_TIMEOUT=120

# ========== CONFIGURAÇÕES DE TRANSFERÊNCIA ==========
# Email para notificar atendentes sobre novas transferências
ADMIN_EMAIL=admin@company.com
# Enviar SMS para atendentes quando há transferência
SEND_SMS_ALERTS=false

# ========== LOGGING ==========
# Nível de log: debug, info, warn, error
LOG_LEVEL=info
# Salvar logs em arquivo
LOG_TO_FILE=false
LOG_FILE=./logs/app.log

# ========== SEGURANÇA ==========
# Token JWT para autenticação (gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=seu_secret_jwt_aleatorio_aqui
# Habilitar CORS
CORS_ENABLED=true
# Origens permitidas (separadas por vírgula)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ========== RECURSOS DE IA AVANÇADOS ==========
# Usar cache de prompts para economizar tokens
USE_PROMPT_CACHE=true
# Máximo de histórico de mensagens a manter
MAX_CONVERSATION_HISTORY=50
# Limpar histórico após (minutos)
CONVERSATION_CLEANUP_MINUTES=60

# ========== NOTIFICAÇÕES ==========
# Habilitar notificações push
PUSH_NOTIFICATIONS_ENABLED=false
# URL para webhook de notificações
WEBHOOK_URL=https://seu-dominio.com/webhook

# ========== INTEGRAÇÃO COM TERCEIROS ==========
# Redis para cache (opcional)
REDIS_URL=redis://localhost:6379
# Sentry para error tracking (opcional)
SENTRY_DSN=
# Analytics (opcional)
ANALYTICS_KEY=
